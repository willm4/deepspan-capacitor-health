{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "experimentalDecorators": true,
    "lib": ["ES2017", "DOM"],
    "module": "es2017",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist/esm/",
    "sourceMap": true,
    "strict": true,
    "target": "ES2017"
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
